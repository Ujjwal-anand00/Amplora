# ==============================================================================
# Campaign Amplification Platform - Mobile App Environment Configuration
# ==============================================================================
# Copy this file to .env or .env.local for local testing:
#   cp .env.example .env
#
# NOTE: Variables prefixed with EXPO_PUBLIC_ are bundled into client code.
# NEVER PUT DATABASE_URL, AUTH_SECRET, OR PRIVATE CREDENTIALS IN THIS FILE.

# ------------------------------------------------------------------------------
# Backend API Base URL
# ------------------------------------------------------------------------------
# Local Development:
# - Web browser / iOS Simulator:
#   EXPO_PUBLIC_API_URL="http://localhost:4000/api"
#
# - Android Emulator:
#   EXPO_PUBLIC_API_URL="http://10.0.2.2:4000/api"
#
# - Physical Mobile Device (Expo Go over Wi-Fi LAN):
#   EXPO_PUBLIC_API_URL="http://192.168.1.6:4000/api"
EXPO_PUBLIC_API_URL="http://localhost:4000/api"

# ------------------------------------------------------------------------------
# Production Deployment
# ------------------------------------------------------------------------------
# When building for production (EAS Build / Production Release), set:
# EXPO_PUBLIC_API_URL="https://your-campaign-api.onrender.com/api"
