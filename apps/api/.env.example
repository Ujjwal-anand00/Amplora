# ==============================================================================
# Campaign Amplification Platform - API Environment Configuration
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# DO NOT COMMIT SENSITIVE PRODUCTION CREDENTIALS TO GIT.
# In production (Render dashboard), set these environment variables directly.

# Server Port (Render dynamically assigns PORT in production)
PORT=4000

# Environment Mode: development | production | test
NODE_ENV=development

# ------------------------------------------------------------------------------
# PostgreSQL Database Connection Strings
# ------------------------------------------------------------------------------
# Local Development:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/campaigns?schema=public"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/campaigns?schema=public"
#
# Production (Supabase):
# 1. DATABASE_URL: Connect to Supabase Transaction Pooler (port 6543) for runtime API queries:
#    DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"
#
# 2. DIRECT_URL: Connect to Supabase Direct connection (port 5432) for running Prisma migrations:
#    DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/campaigns?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/campaigns?schema=public"

# ------------------------------------------------------------------------------
# Security & Access
# ------------------------------------------------------------------------------
# Permitted CORS Origins (comma-separated list for multiple web domains, or * for local development)
# Production example: CLIENT_ORIGIN="https://campaign-one-pearl.vercel.app,http://localhost:8081"
CLIENT_ORIGIN="*"

# Authentication Secret (Used for JWT signing. Must be at least 32 characters in production)
# Generate a secure key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="dev-super-secret-key-campaign-amplification-2026"

# ------------------------------------------------------------------------------
# Google Gemini AI Integration (Server-Side Only)
# ------------------------------------------------------------------------------
# Server-side official Google Gemini API Key (e.g. Gemini 2.5 Flash / Pro).
# Obtain key from Google AI Studio: https://aistudio.google.com/
# NEVER put this key in client-side code, mobile bundles, or version control.
# If omitted or quota exhausted, the backend falls back gracefully to factual heuristics.
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyGoesHerePlaceholderOnly"

