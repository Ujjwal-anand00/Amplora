{
  "name": "campaign-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "start": "npm run start --workspace=mobile",
    "mobile": "npm run start --workspace=mobile",
    "mobile:android": "npm run android --workspace=mobile",
    "mobile:web": "npm run web --workspace=mobile",
    "api": "npm run dev --workspace=api",
    "api:build": "npm run build --workspace=api",
    "api:start": "npm run start --workspace=api",
    "api:deploy-migrate": "npm run prisma:deploy --workspace=api",
    "api:seed": "npm run prisma:seed --workspace=api",
    "prisma:generate": "npm run prisma:generate --workspace=api",
    "test:api": "npm run test --workspace=api",
    "test": "npm run test --workspace=api",
    "typecheck:mobile": "npx --workspace=mobile tsc --noEmit"
  },
  "devDependencies": {
    "expo": "~57.0.30",
    "expo-router": "~57.0.28"
  }
}
